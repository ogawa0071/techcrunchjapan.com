# Workers Static Assets response headers (public/ files are served before the Worker).

# Fingerprinted build output
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Theme files of the original WordPress site (never change)
/wp-content/themes/*
  Cache-Control: public, max-age=2592000

/index.css
  Cache-Control: public, max-age=86400
