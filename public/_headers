# Workers Static Assets response headers (public/ files are served before the Worker;
# responses generated by the Worker set their own headers in src/server.ts).

/*
  Strict-Transport-Security: max-age=63072000

# Fingerprinted build output
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Theme files of the original WordPress site (never change)
/wp-content/themes/*
  Cache-Control: public, max-age=2592000

/index.css
  Cache-Control: public, max-age=86400
