{
  // oxfmt (via the Oxc extension). The language-specific entry also wins over
  // per-language formatters set in user settings (e.g. Prettier).
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[javascript][javascriptreact][typescript][typescriptreact][json][jsonc][css][markdown][yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  // oxlint safe fixes on explicit save.
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  }
}
