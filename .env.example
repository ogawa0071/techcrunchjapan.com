# Copy this file to .env. The scripts (bun run db:copy-from-tidb, bun run sitemap),
# wrangler and drizzle-kit read it; the Worker never sees these values (wrangler.jsonc
# declares no secrets).

# Source database for `bun run db:copy-from-tidb` (TiDB Cloud / MySQL).
# SOURCE_DATABASE_URL=mysql://USER:PASSWORD@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/DATABASE

# The production database (`--remote` of db:migrate, db:copy-from-tidb and sitemap, and
# deployments) is reached with the `bunx wrangler login` session, or with an API token
# and the account id. The token needs D1 edit and Workers Scripts edit permissions (the
# scripts reach D1 through a temporary preview Worker).
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ACCOUNT_ID=...
