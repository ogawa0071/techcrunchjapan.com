# `bun run` loads this file automatically (copy it to .env). The Worker never sees these
# values (wrangler.jsonc declares no secrets).

# Source database for `bun run db:copy-from-tidb` (TiDB Cloud / MySQL).
# SOURCE_DATABASE_URL=mysql://USER:PASSWORD@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/DATABASE

# The production database (`--remote` of db:migrate, db:copy-from-tidb and sitemap, and
# deployments) is reached with the `bunx wrangler login` session, or with an API token
# (permissions: D1 edit, Workers Scripts edit) and the account id:
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ACCOUNT_ID=...

# `bun run db:studio:remote` (Drizzle Studio on the production database, through the
# Cloudflare API): CLOUDFLARE_ACCOUNT_ID above, the database_id of wrangler.jsonc and a
# token with D1 edit permission.
# CLOUDFLARE_DATABASE_ID=...
# CLOUDFLARE_D1_TOKEN=...
