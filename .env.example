# `bun run` loads this file automatically (copy it to .env).

# Database for drizzle-kit and the scripts (db:migrate, db:copy-from-tidb, sitemap).
# For Neon, use the direct (non-pooled) connection string with ?sslmode=verify-full.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/techcrunchjapan

# Source database for `bun run db:copy-from-tidb` (TiDB Cloud / MySQL).
# SOURCE_DATABASE_URL=mysql://USER:PASSWORD@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/DATABASE

# Database used by `bun run dev` / `bun run preview` instead of
# hyperdrive[0].localConnectionString in wrangler.jsonc (e.g. a Neon branch).
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://...
