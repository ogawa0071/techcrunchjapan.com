{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techcrunchjapan",
  // Custom entry wrapping @tanstack/react-start/server-entry (redirects, media proxy, edge cache).
  "main": "src/server.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // The deployed version id is part of the edge-cache key (see src/server.ts).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  "vars": {
    // Public R2 bucket holding the original WordPress uploads (/wp-content/uploads/*).
    "UPLOADS_ORIGIN": "https://r2.techcrunchjapan.com/",
  },

  // Neon via Hyperdrive (connection pooling close to the database).
  // Create it once with:
  //   npx wrangler hyperdrive create techcrunchjapan --connection-string="postgresql://..."
  // and paste the returned id below. Local development connects to `localConnectionString`
  // (or CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/techcrunchjapan",
    },
  ],

  // Serve the site on the production domain once ready to switch over from Vercel:
  // "routes": [{ "pattern": "techcrunchjapan.com", "custom_domain": true }],
}
